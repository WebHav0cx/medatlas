{
  "tailwindCSS.experimental.configFile": "src/app/globals.css",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/.next": true,
    "**/.next-*": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/.next-*": true
  }
}
